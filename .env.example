# ---------------------------------------------------------------------------
# a2a-bridge configuration. Copy to .env and fill in. Every value can also be
# set as a normal environment variable (environment wins over .env).
# ---------------------------------------------------------------------------

# --- Copilot Studio connection (set exactly ONE of these two) ---------------
# Option A: Web channel security secret
#   Copilot Studio > Settings > Security > Web channel security > Secret 1
DIRECTLINE_SECRET=
# Option B: Token endpoint (agents without "Require secure access")
#   Copilot Studio > Channels > Mobile app > Token Endpoint
# DIRECTLINE_TOKEN_ENDPOINT=https://<env>.environment.api.powerplatform.com/powervirtualagents/botsbyschema/<schema>/directline/token?api-version=2022-03-01-preview

# Regional Direct Line endpoint. Use the one that matches your environment's
# region, e.g. https://europe.directline.botframework.com/v3/directline
DIRECTLINE_BASE_URL=https://directline.botframework.com/v3/directline
AGENT_LOCALE=en-US

# --- A2A server ------------------------------------------------------------
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
# The URL other agents use to reach this bridge (goes into the agent card).
BRIDGE_PUBLIC_URL=http://localhost:8000
# Optional. Pipe-separated keys; callers send "Authorization: Bearer <key>".
# Leave empty to disable auth (only do that on a private network).
BRIDGE_API_KEYS=

# --- Agent card (what other agents see) ------------------------------------
AGENT_NAME=Copilot Studio Agent
AGENT_DESCRIPTION=A Microsoft Copilot Studio agent exposed over the A2A protocol.
AGENT_VERSION=1.0.0
AGENT_SKILL_NAME=Chat
AGENT_SKILL_DESCRIPTION=Have a multi-turn conversation with the Copilot Studio agent.
# Pipe-separated lists
AGENT_SKILL_TAGS=copilot-studio|chat
AGENT_SKILL_EXAMPLES=What can you help me with?

# --- Behaviour -------------------------------------------------------------
# Max seconds to wait for the agent's first reply.
REPLY_TIMEOUT_SECONDS=60
# Seconds of silence after a reply that mark the end of the agent's turn.
IDLE_TIMEOUT_SECONDS=2
POLL_INTERVAL_SECONDS=0.5
# Idle conversations are forgotten after this many seconds.
CONVERSATION_TTL_SECONDS=1800
MAX_CONVERSATIONS=10000
LOG_LEVEL=INFO
